# Copy to .env and set separate strong passwords. Plain MQTT/HTTP is LAN-only.
MQTT_USER=urex-gateway
MQTT_PASSWORD=CHANGE_ME_gateway_password
DASHBOARD_USER=operator
DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
MQTT_HOST=0.0.0.0
MQTT_PORT=1883
# For access from a phone on your trusted LAN, change HTTP_HOST to 0.0.0.0.
